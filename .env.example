# Copy to .env (gitignored). Everything is optional — the app runs fully offline-deterministic with no keys.

# SEC asks every automated client to identify itself. Put a real contact address here.
SEC_USER_AGENT=DueDiligenceRoom contact@example.com

# LLM provider for narrative prose (optional). One of: offline | gemini | anthropic | openai | ollama
DD_LLM_PROVIDER=offline
# DD_LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# Server
DD_HOST=127.0.0.1
DD_PORT=8112
# DD_DATA_DIR=./data
